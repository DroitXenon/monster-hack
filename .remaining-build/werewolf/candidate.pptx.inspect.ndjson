{"kind":"textbox","id":"sh/itoz2tk7","slideIndex":0,"position":{"left":64,"top":165,"width":1150,"height":100},"text":"1. Count activity rows in each Autumn and Spring calendar week.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#E6ECEF","alignment":"left"}}
{"kind":"textbox","id":"sh/juhgvy1s","slideIndex":0,"position":{"left":64,"top":280,"width":1150,"height":100},"text":"2. Spike threshold: median + 3 × MAD; use the 95th percentile if MAD is zero.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#E6ECEF","alignment":"left"}}
{"kind":"textbox","id":"sh/wr6h0j2h","slideIndex":0,"position":{"left":64,"top":395,"width":1150,"height":100},"text":"3. Flag at least two spikes in each term. This is an exploratory heuristic.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#E6ECEF","alignment":"left"}}
{"kind":"textbox","id":"sh/xsfytojm","slideIndex":0,"position":{"left":64,"top":550,"width":1150,"height":50},"text":"Run: python remaining_detectors.py --split Test","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Arial","color":"#FFA54C","alignment":"left"}}
{"kind":"textbox","id":"sh/apozy9kb","slideIndex":0,"position":{"left":64,"top":620,"width":1150,"height":70},"text":"Shared engine runs all seven detectors. HUNT labels are used only for evaluation.\nSource: supplied Monster Guide and dataset; assumptions documented with the code.","geometry":"rect","lineWidth":0,"style":{"fontSize":21,"typeface":"Arial","color":"#B5C5CC","alignment":"left"}}
